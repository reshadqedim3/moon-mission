<body>
  <h1>Ay–Yer sistemi və peyk trayektoriyası</h1>

  <div class="panel">
    <div class="controls">
      <div class="slider-wrap">
        <label for="dvSlider">Ani sürət artımı Δv: <span id="dvValue">0</span> m/s</label>
        <input id="dvSlider" type="range" min="-4000" max="4000" step="10" value="0" />
      </div>

      <div class="slider-wrap">
        <label for="speedSlider">Simulyasiya sürəti: <span id="speedValue">2500</span>×</label>
        <input id="speedSlider" type="range" min="100" max="20000" step="100" value="2500" />
      </div>

      <button id="applyBoostBtn">Sürət artımını tətbiq et</button>
      <button id="pauseBtn">Pause</button>
      <button id="resetBtn">Reset</button>
      <button id="clearTrace">İzi təmizlə</button>
    </div>

    <div class="small">
      Δv istənilən anda verilə bilər. Mənfi Δv veriləndə peykin sürəti azalır. Peykin Yerə görə bucağı da ayrıca göstərilir.
    </div>

    <div class="info">
      <div><strong>Vaxt sürətləndirilməsi</strong><br><span id="timeScaleText"></span></div>
      <div><strong>Peykin sürəti</strong><br><span id="satSpeedText"></span></div>
      <div><strong>Yerə məsafə</strong><br><span id="earthDistText"></span></div>
      <div><strong>Aya məsafə</strong><br><span id="moonDistText"></span></div>
      <div><strong>Peykin bucağı</strong><br><span id="satAngleText"></span></div>
      <div><strong>Keçən vaxt</strong><br><span id="simTimeText"></span></div>
    </div>

    <div class="legend">
      Mavi: Yer | Boz: Ay | Sarı: Peyk | Yaşıl: Peykin izi
    </div>
  </div>

  <canvas id="canvas"></canvas>

  <script>
    const canvas = document.getElementById("canvas");
    const ctx = canvas.getContext("2d");

    function resizeCanvas() {
      canvas.width = canvas.clientWidth * devicePixelRatio;
      canvas.height = canvas.clientHeight * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      updateViewScale();
    }
    window.addEventListener("resize", resizeCanvas);

    const G = 6.67430e-11;
    const M_EARTH = 5.972e24;
    const M_MOON = 7.34767309e22;

    const R_EARTH = 6_371_000;
    const R_MOON = 1_737_400;
    const EARTH_MOON_DISTANCE = 384_400_000;

    const MU_EARTH = G * M_EARTH;
    const MU_MOON = G * M_MOON;

    const T_MOON = 27.321661 * 24 * 3600;
    const OMEGA_MOON = 2 * Math.PI / T_MOON;

    const SAT_ALTITUDE = 30000000;
    const SAT_R0 = R_EARTH + SAT_ALTITUDE;
    const SAT_V0 = Math.sqrt(MU_EARTH / SAT_R0);

    let TIME_SCALE = 2500;
    let paused = false;

    let viewScale;

    function updateViewScale() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;

      const orbitDiameter = 2 * EARTH_MOON_DISTANCE;
      const marginFactor = 1.18;

      const usableW = w * 0.96;
      const usableH = h * 0.90;

      viewScale = Math.min(
        usableW / (orbitDiameter * marginFactor),
        usableH / (orbitDiameter * marginFactor)
      );
    }

    function center() {
      return {
        x: canvas.clientWidth / 2,
        y: canvas.clientHeight / 2
      };
    }

    const dvSlider = document.getElementById("dvSlider");
    const dvValue = document.getElementById("dvValue");
    const speedSlider = document.getElementById("speedSlider");
    const speedValue = document.getElementById("speedValue");
    const applyBoostBtn = document.getElementById("applyBoostBtn");
    const pauseBtn = document.getElementById("pauseBtn");
    const resetBtn = document.getElementById("resetBtn");
    const clearTraceBtn = document.getElementById("clearTrace");

    dvValue.textContent = dvSlider.value;
    dvSlider.addEventListener("input", () => {
      dvValue.textContent = dvSlider.value;
    });

    speedValue.textContent = speedSlider.value;
    speedSlider.addEventListener("input", () => {
      TIME_SCALE = Number(speedSlider.value);
      speedValue.textContent = speedSlider.value;
      document.getElementById("timeScaleText").textContent =
        TIME_SCALE.toLocaleString("az-AZ") + "×";
    });

    function add(a, b) { return { x: a.x + b.x, y: a.y + b.y }; }
    function sub(a, b) { return { x: a.x - b.x, y: a.y - b.y }; }
    function mul(a, k) { return { x: a.x * k, y: a.y * k }; }
    function mag(a) { return Math.hypot(a.x, a.y); }
    function norm(a) {
      const m = mag(a);
      return m === 0 ? { x: 0, y: 0 } : { x: a.x / m, y: a.y / m };
    }

    function formatKm(m) {
      return (m / 1000).toLocaleString("az-AZ", { maximumFractionDigits: 0 }) + " km";
    }

    function formatSpeed(v) {
      return v.toLocaleString("az-AZ", { maximumFractionDigits: 1 }) + " m/s";
    }

    function formatAngleDeg(rad) {
      let deg = rad * 180 / Math.PI;
      if (deg < 0) deg += 360;
      return deg.toLocaleString("az-AZ", { maximumFractionDigits: 2 }) + "°";
    }

    function formatSimTime(seconds) {
      const days = Math.floor(seconds / 86400);
      const hours = Math.floor((seconds % 86400) / 3600);
      const mins = Math.floor((seconds % 3600) / 60);
      return `${days} gün ${hours} saat ${mins} dəq`;
    }

    let simTime = 0;
    let satellite = null;
    let trace = [];

    function getMoonState(t) {
      const angle = OMEGA_MOON * t;
      return {
        pos: {
          x: EARTH_MOON_DISTANCE * Math.cos(angle),
          y: EARTH_MOON_DISTANCE * Math.sin(angle)
        },
        vel: {
          x: -EARTH_MOON_DISTANCE * OMEGA_MOON * Math.sin(angle),
          y:  EARTH_MOON_DISTANCE * OMEGA_MOON * Math.cos(angle)
        }
      };
    }

    function resetSimulation() {
      simTime = 0;
      trace = [];
      paused = false;
      pauseBtn.textContent = "Pause";

      satellite = {
        pos: { x: 0, y: SAT_R0 },
        vel: { x: -SAT_V0, y: 0 }
      };
    }

    function applyBoost() {
      const dv = Number(dvSlider.value);
      const tangent = norm(satellite.vel);
      satellite.vel = add(satellite.vel, mul(tangent, dv));
    }

    applyBoostBtn.addEventListener("click", applyBoost);

    pauseBtn.addEventListener("click", () => {
      paused = !paused;
      pauseBtn.textContent = paused ? "Resume" : "Pause";
    });

    resetBtn.addEventListener("click", resetSimulation);

    clearTraceBtn.addEventListener("click", () => {
      trace = [];
    });

    function accelerationAt(pos, moonPos) {
      const rE = sub({ x: 0, y: 0 }, pos);
      const dE = mag(rE);
      const aE = mul(rE, MU_EARTH / Math.pow(dE, 3));

      const rM = sub(moonPos, pos);
      const dM = mag(rM);
      const aM = mul(rM, MU_MOON / Math.pow(dM, 3));

      return add(aE, aM);
    }

    function step(realDt) {
      if (paused) return;

      const dt = realDt * TIME_SCALE;
      const substeps = 6;
      const h = dt / substeps;

      for (let i = 0; i < substeps; i++) {
        const moon1 = getMoonState(simTime);

        const k1v = accelerationAt(satellite.pos, moon1.pos);
        const k1x = satellite.vel;

        const moon2 = getMoonState(simTime + h / 2);
        const p2 = add(satellite.pos, mul(k1x, h / 2));
        const v2 = add(satellite.vel, mul(k1v, h / 2));
        const k2v = accelerationAt(p2, moon2.pos);
        const k2x = v2;

        const p3 = add(satellite.pos, mul(k2x, h / 2));
        const v3 = add(satellite.vel, mul(k2v, h / 2));
        const k3v = accelerationAt(p3, moon2.pos);
        const k3x = v3;

        const moon4 = getMoonState(simTime + h);
        const p4 = add(satellite.pos, mul(k3x, h));
        const v4 = add(satellite.vel, mul(k3v, h));
        const k4v = accelerationAt(p4, moon4.pos);
        const k4x = v4;

        satellite.pos = add(
          satellite.pos,
          mul(
            add(
              add(k1x, mul(add(k2x, k3x), 2)),
              k4x
            ),
            h / 6
          )
        );

        satellite.vel = add(
          satellite.vel,
          mul(
            add(
              add(k1v, mul(add(k2v, k3v), 2)),
              k4v
            ),
            h / 6
          )
        );

        simTime += h;
        trace.push({ x: satellite.pos.x, y: satellite.pos.y });
        if (trace.length > 15000) trace.shift();
      }
    }

    function worldToScreen(p) {
      const c = center();
      return {
        x: c.x + p.x * viewScale,
        y: c.y - p.y * viewScale
      };
    }

    function drawBody(pos, radiusMeters, color, minPx = 2) {
      const sp = worldToScreen(pos);
      const r = Math.max(radiusMeters * viewScale, minPx);

      ctx.beginPath();
      ctx.arc(sp.x, sp.y, r, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
    }

    function drawTrace() {
      if (trace.length < 2) return;

      ctx.beginPath();
      const p0 = worldToScreen(trace[0]);
      ctx.moveTo(p0.x, p0.y);

      for (let i = 1; i < trace.length; i++) {
        const p = worldToScreen(trace[i]);
        ctx.lineTo(p.x, p.y);
      }

      ctx.strokeStyle = "#35d07f";
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    function drawOrbitGuide() {
      const c = center();
      const r = EARTH_MOON_DISTANCE * viewScale;

      ctx.beginPath();
      ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(180, 200, 255, 0.22)";
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }

    function drawAngleGuide() {
      const earthScreen = worldToScreen({ x: 0, y: 0 });
      const satScreen = worldToScreen(satellite.pos);

      ctx.beginPath();
      ctx.moveTo(earthScreen.x, earthScreen.y);
      ctx.lineTo(satScreen.x, satScreen.y);
      ctx.strokeStyle = "rgba(255, 255, 0, 0.55)";
      ctx.lineWidth = 1.2;
      ctx.stroke();
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);

      drawOrbitGuide();

      const moon = getMoonState(simTime);

      drawTrace();
      drawAngleGuide();

      drawBody({ x: 0, y: 0 }, R_EARTH, "#3b82f6", 3.5);
      drawBody(moon.pos, R_MOON, "#cbd5e1", 2.8);
      drawBody(satellite.pos, 0, "#facc15", 3.5);

      const satSpeed = mag(satellite.vel);
      const earthDist = mag(satellite.pos);
      const moonDist = mag(sub(satellite.pos, moon.pos));
      const satAngle = Math.atan2(satellite.pos.y, satellite.pos.x);

      document.getElementById("timeScaleText").textContent =
        TIME_SCALE.toLocaleString("az-AZ") + "×";
      document.getElementById("satSpeedText").textContent = formatSpeed(satSpeed);
      document.getElementById("earthDistText").textContent = formatKm(earthDist);
      document.getElementById("moonDistText").textContent = formatKm(moonDist);
      document.getElementById("satAngleText").textContent = formatAngleDeg(satAngle);
      document.getElementById("simTimeText").textContent = formatSimTime(simTime);
    }

    let lastTime = performance.now();

    function animate(now) {
      const realDt = Math.min((now - lastTime) / 1000, 0.03);
      lastTime = now;

      step(realDt);
      draw();
      requestAnimationFrame(animate);
    }

    resizeCanvas();
    resetSimulation();
    draw();
    requestAnimationFrame(animate);
  </script>
</body>
</html>
