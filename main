      align-items: center;
    }

    h1 {
      margin: 16px 0 8px;
      font-size: 24px;
    }

    .panel {
      width: min(1150px, 96vw);
      background: #121a33;
      border: 1px solid #2d3a66;
      border-radius: 14px;
      padding: 14px 16px;
      margin-bottom: 12px;
      box-sizing: border-box;
    }

    .controls {
      display: grid;
      grid-template-columns: 1fr 1fr auto auto auto auto;
      gap: 12px;
